{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.heretek.ai/schemas/sim.replay/v1.json",
  "title": "sim.replay",
  "description": "JSON-RPC 2.0 method sim.replay/v1 params+result envelopes. Spec 04 section 2.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "string"
        },
        "ticks": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "scenario"
      ],
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "string"
        },
        "ticks": {
          "type": "integer"
        },
        "hash": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "match": {
          "type": "boolean"
        }
      },
      "required": [
        "scenario",
        "ticks",
        "hash",
        "match"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "params",
    "result"
  ],
  "additionalProperties": true
}
