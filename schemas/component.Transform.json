{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.heretek.ai/schemas/component.Transform/v1.json",
  "title": "Transform",
  "description": "Inspector schema for Transform (spec 04 section 3). Drives egui, Tauri/React, and CLI inspectors so they can never disagree.",
  "type": "object",
  "properties": {
    "translation": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        0,
        0,
        0
      ]
    },
    "rotation": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "default": [
        0,
        0,
        0,
        1
      ]
    },
    "scale": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        1,
        1,
        1
      ]
    }
  },
  "required": [
    "translation",
    "rotation",
    "scale"
  ],
  "additionalProperties": false
}
