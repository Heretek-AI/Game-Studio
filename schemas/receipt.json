{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.heretek.ai/schemas/receipt/v1.json",
  "title": "StagingReceipt",
  "description": "receipt.json carried by every staging dir (spec 05 section 7). Content addressing is blake3 throughout (spec 00); model provenance for L-4 travels in model_card_url + model_license.",
  "type": "object",
  "properties": {
    "staging_hash": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "prompt_hash": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "model_digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "model_card_url": { "type": "string" },
    "model_license": { "type": "string" },
    "seed": { "type": "integer" },
    "params": {
      "type": "object",
      "properties": { "temperature": { "type": "number" } },
      "required": ["temperature"]
    },
    "gates": { "type": "string" },
    "approver": { "type": "string" },
    "merged_hash": { "type": ["string", "null"] },
    "ai_tier": { "type": "string" }
  },
  "required": [
    "staging_hash",
    "prompt_hash",
    "model_digest",
    "model_card_url",
    "model_license",
    "seed",
    "params",
    "gates",
    "approver",
    "ai_tier"
  ],
  "additionalProperties": false
}
