{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-studio.heretek.ai/schemas/scene.query/v1.json",
  "title": "scene.query",
  "description": "JSON-RPC 2.0 method scene.query/v1 params+result envelopes. Spec 04 section 2.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array"
        },
        "scene_hash": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        }
      },
      "required": [
        "nodes",
        "scene_hash"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "params",
    "result"
  ],
  "additionalProperties": true
}
