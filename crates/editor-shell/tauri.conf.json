{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game-Studio",
  "version": "0.1.0",
  "identifier": "ai.heretek.game-studio",
  "build": {
    "frontendDist": "../tools/panels",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "asset-browser",
        "title": "Game-Studio — Asset Browser",
        "url": "asset-browser.html",
        "width": 1100,
        "height": 700
      },
      {
        "label": "chat",
        "title": "Game-Studio — AI Chat",
        "url": "chat.html",
        "width": 480,
        "height": 800
      },
      {
        "label": "diff-approve",
        "title": "Game-Studio — Diff / Approve",
        "url": "diff.html",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:39002"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../schemas/rpc-manifest.json"]
  },
  "comment": "Phase 3 (spec 04 section 1): Tauri v2 hosts TOOLS ONLY (asset browser, AI chat, diff/approve). The viewport stays native (winit + wgpu + egui overlay) and all panels speak the frozen JSON-RPC surface (schemas/rpc.*.v1.json) over ws://127.0.0.1:39002 and stdio. The Tauri crate link is deferred to the toolchain-bump ADR (winit/jsonrpsee edition2024 transitives fail on Rust 1.82); this config is the tools-windows contract the shell already serves headless."
}
